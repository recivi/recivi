---
// The look and feel of this component mirrors the `DocBlock` component in pls,
// which documents a hand-authored config schema. Keep the two visually in sync.
// https://github.com/pls-rs/pls/blob/main/docs/src/components/DocBlock.astro
import { Badge, Code } from "@astrojs/starlight/components";

import { fromBase64, toBase64 } from "@/utils/base64";
import { parseLength, parseRange } from "@/utils/schema";

interface Props {
	name?: string;
	schemaString: string;
	hrefFmt: string;
	isRoot?: boolean;
	isRequired?: boolean;
}
const {
	name,
	schemaString,
	hrefFmt,
	isRoot = false,
	isRequired = false,
} = Astro.props;
const schema = JSON.parse(fromBase64(schemaString));

const ref = schema.$ref?.split("/").at(-1);

const range = parseRange(schema);
const length = parseLength(schema);

/**
 * Convert a value to a pretty-printed JSON string.
 *
 * @param value the value to stringify
 * @returns a pretty-printed JSON string
 */
function prettyStr(value: unknown) {
	return JSON.stringify(value, null, 2);
}

/**
 * Convert a value to a schema string to pass nested `<Astro.self />`.
 *
 * @param value the value to convert
 * @returns a base64-encoded schema string
 */
function schemaStr(value: unknown) {
	return toBase64(JSON.stringify(value));
}

/**
 * Convert a very small subset of Markdown to HTML using a rudimentary
 * regex-based string-replacement-based approach.
 *
 * Only supports inline code for now.
 *
 * @param text the Markdown text to convert
 * @returns the converted HTML string
 */
function rudimentaryMd(text: string): string {
	if (!text) {
		return "no description";
	}

	// Escape HTML and replace inline Markdown code with HTML code tags.
	return text
		.replace("<", "&lt;")
		.replace(">", "&gt;")
		.replaceAll(/`([^`]+)`/gu, "<code>$1</code>");
}
---

<div class="schema-block">
	{
		!isRoot && (
			<div class="header">
				{(name ?? schema.id) && <div class="name">{name ?? schema.id}</div>}
				{ref ? (
					<a
						class="type-link"
						href={hrefFmt.replace("{ref}", ref.toLocaleLowerCase())}
					>
						<Badge text={ref} />
					</a>
				) : (
					schema.type && <Badge text={schema.type} />
				)}
				{isRequired && <Badge text="required" variant="caution" />}
			</div>
		)
	}

	<div class="description" set:html={rudimentaryMd(schema.description)} />

	{
		schema.format && (
			<p class="meta">
				Format: <code>{schema.format}</code>
			</p>
		)
	}
	{length && <p class="meta">Length: {length}</p>}
	{
		schema.default && (
			<p class="meta">
				Default: <code>{prettyStr(schema.default)}</code>
			</p>
		)
	}
	{
		range && (
			<p class="meta">
				Range: <span class="math" set:html={range} />
			</p>
		)
	}
	{
		schema.enum && (
			<details>
				<summary>Valid options</summary>
				<ul>
					{schema.enum.map((option: string) => (
						<li>
							<code>{prettyStr(option)}</code>
						</li>
					))}
				</ul>
			</details>
		)
	}

	{
		schema.type === "object" && (
			<details>
				<summary>Properties</summary>
				{schema.properties &&
					Object.entries(schema.properties).map(([key, value]) => (
						<Astro.self
							isRequired={schema.required?.includes(key)}
							name={key}
							schemaString={schemaStr(value)}
							{hrefFmt}
						/>
					))}
			</details>
		)
	}

	{
		schema.type === "array" && (
			<details open>
				<summary>Item</summary>
				{schema.items && (
					<Astro.self schemaString={schemaStr(schema.items)} {hrefFmt} />
				)}
				{schema.prefixItems &&
					schema.prefixItems.map((item: unknown, index: number) => (
						<Astro.self
							name={`Item ${index + 1}`}
							schemaString={schemaStr(item)}
							{hrefFmt}
						/>
					))}
			</details>
		)
	}

	{
		schema.anyOf && (
			<details>
				<summary>Any of</summary>
				{schema.anyOf.map((item: unknown, index: number) => (
					<Astro.self
						name={`Variant ${index + 1}`}
						schemaString={schemaStr(item)}
						{hrefFmt}
					/>
				))}
			</details>
		)
	}

	{
		schema.examples && (
			<details>
				<summary>Examples</summary>
				{schema.examples.map((example: unknown) => (
					<Code code={prettyStr(example)} lang="json" />
				))}
			</details>
		)
	}
</div>

<style>
	div.header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}

	/* Field names are literal schema keys, so render them in the same mono face
	 * used for inline code, matching the type badge. */
	div.name {
		font-weight: 600;
		color: var(--sl-color-white);
		font-family: var(--__sl-font-mono);
	}

	a.type-link {
		text-decoration: none;
	}

	p.meta {
		margin-top: 0;
	}

	.math {
		/* Transitional family */
		font-family: Charter, "Bitstream Charter", "Sitka Text", Cambria, serif;
	}
</style>
