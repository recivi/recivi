---
import { EpicDetails } from "virtual:pf/components";
import Entity from "virtual:pf/layouts/Entity";
import reciviData from "virtual:recivi/data";

export function getStaticPaths() {
	const epics = reciviData.creations;
	return epics.map((epic) => ({
		params: { epicSlug: epic.slug },
		props: { epic },
	}));
}

const { epic } = Astro.props;

const entityType: [string, string] = ["Epic", "Epics"];
const name = epic.name;
const description = `Know more about my work on ${epic.name}.`;
---

<Entity {entityType} {name} {description}>
	<EpicDetails {epic} />
</Entity>
