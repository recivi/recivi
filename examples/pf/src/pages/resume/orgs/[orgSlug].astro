---
import { OrgDetails } from "virtual:pf/components";
import reciviData from "virtual:recivi/data";

import Entity from "@recivi/pf/layouts/defs/Entity.astro";

export function getStaticPaths() {
	const orgs = reciviData.work;
	return orgs.map((org) => ({
		params: { orgSlug: org.slug },
		props: { org },
	}));
}

const { org } = Astro.props;

const entityType: [string, string] = ["Organization", "Organizations"];
const name = org.name;
const description = `Know more about my work at ${org.name}.`;
---

<Entity {entityType} {name} {description}>
	<OrgDetails {org} />
</Entity>
