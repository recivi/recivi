---
import "virtual:pf/custom-css/Post";

import {
	Breadcrumbs,
	Elements,
	PfDate,
	Table,
	Toc,
} from "virtual:pf/components";
import nav from "virtual:pf/nav";
import projectContext from "virtual:pf/project-context";

import { getCollection } from "astro:content";

import { pageSchema } from "../../content";
import { getPostsTable, isNotDraft } from "../../utils/collections";
import { getPageByEntrypoint } from "../../utils/collections";
import { getArticleMetaTags } from "../../utils/metas";
import { getUrlFromPattern } from "../../utils/project_context";
import type { PostProps } from "../props/Post";
import Web from "./Web.astro";

type Props = PostProps;
const { postData, headings } = Astro.props;

const relatedPosts = (
	await getCollection(
		"blog",
		(item) =>
			isNotDraft(item) &&
			item.data.series &&
			item.data.series === postData.series,
	)
).toReversed();
const relatedPostsTable = getPostsTable(relatedPosts);

const frontmatter = pageSchema.parse({
	...postData,
	title: `Post: ${postData.title}`,
});

const indexUrl = nav.blog.index
	? getUrlFromPattern(projectContext, nav.blog.index.pattern)
	: undefined;
const indexPage = nav.blog.index
	? await getPageByEntrypoint(nav.blog.index.entrypoint)
	: undefined;
const title = indexPage?.data.title ?? "Blog";
---

<Web {frontmatter}>
	<Elements slot="metas" items={getArticleMetaTags(postData)} tag="meta" />

	<Breadcrumbs
		slot="primary-header"
		crumbs={[
			{ url: { dest: "/", label: "Home" } },
			indexUrl ? { url: { dest: indexUrl, label: title } } : title,
			"Posts",
		]}
	/>

	<div slot="extra-header"><strong>Table of contents</strong></div>

	<Toc slot="extra" {headings} />

	<h1>{postData.title}</h1>

	<slot />

	<hr />

	<dl>
		<dt>Published</dt>
		<dd>
			<PfDate date={postData.pubDate} />
		</dd>
		<dt>Categories</dt>
		<dd>
			<ul class="linear">
				{postData.categories.map((category) => <li>#{category}</li>)}
			</ul>
		</dd>
	</dl>

	{
		postData.series ? (
			<Fragment>
				<hr />
				<h2 id="series">Series</h2>
				<p>
					This post is part of the "{postData.series}" series. If you liked it,
					you might also like the other posts in this series.
				</p>
				<div x-data="{ activeCategories: [] }">
					<Table class="last-element" table={relatedPostsTable} />
				</div>
			</Fragment>
		) : undefined
	}
</Web>
