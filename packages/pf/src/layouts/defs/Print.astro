---
import "virtual:pf/custom-css/Print";
import "../../styles/print.css";

import { Letterhead } from "virtual:pf/components";
import config from "virtual:pf/config";
import Root from "virtual:pf/layouts/Root";

import { getFullPageTitle } from "../../utils/metas";
import type { PrintProps } from "../props/Print";

type Props = PrintProps;
const { title = "Print", ...attrs } = Astro.props;

const creditsCss = config.showCredits
	? `@layer pf-media {
	@page {
		@bottom-center {
			content: "Built with Récivi";
			color: var(--pf-color-fg-subtle);
			text-align: right;
		}

		@bottom-right {
			content: "recivi.pages.dev";
			color: var(--pf-color-fg-subtle);
			font-family: var(--pf-font-family-monospace);
			font-size: var(--pf-font-size-monospace);
			width: fit-content;
		}
	}
}`
	: "";
---

<Root data-media="print" {...attrs}>
	<Fragment slot="head">
		<title>{getFullPageTitle(title)}</title>

		{creditsCss ? <style is:inline set:html={creditsCss} /> : undefined}

		<slot name="head" />
	</Fragment>

	<!-- DEFAULT SLOT -->
	<main data-pf-print-content>
		<div class="header">
			<Letterhead />
		</div>

		<div class="content">
			<slot />
		</div>
	</main>
</Root>

<script>
	import { paginatePrintPreview } from "../../utils/print_preview";

	// Event `load` always fires after `DOMContentLoaded`.
	window.addEventListener("load", async () => {
		const detail = await paginatePrintPreview();
		const event = new CustomEvent("pf:paginated-print-preview", { detail });
		document.dispatchEvent(event);
	});
</script>

<style>
	/*
		 * A full-width letter head is present at the top of the page.
		 * ┌───┐
		 * │ L │
		 * ├───┤
		 * │ C │
		 *
		 */

	@layer pf-core {
		main {
			inline-size: 100%;
		}
	}
</style>
