---
import "virtual:pf/custom-css/Print";
import "../../styles/print.css";

import { Letterhead } from "virtual:pf/components";
import config from "virtual:pf/config";

import { getFullPageTitle } from "../../utils/metas";
import type { PrintProps } from "../props/Print";
import Root from "./Root.astro";

type Props = PrintProps;
const { title = "Print" } = Astro.props;

const creditsCss = config.showCredits
	? `@layer pf.props {
	:root {
		--pf-print-credits-left: "Built with Récivi";
		--pf-print-credits-right: "https://recivi.dhruvkb.dev";
	}
}`
	: "";
---

<Root data-media="print" {...Astro.props}>
	<Fragment slot="head">
		<title>{getFullPageTitle(title)}</title>

		{creditsCss ? <style is:inline set:html={creditsCss} /> : undefined}

		<slot name="head" />
	</Fragment>

	<!-- DEFAULT SLOT -->
	<main data-pf-print-content>
		<div class="header">
			<Letterhead />
		</div>

		<div class="content">
			<slot />
		</div>
	</main>
</Root>

<script>
	import { paginatePrintPreview } from "../../utils/print_preview";

	void paginatePrintPreview();
</script>

<style>
	/*
		 * A full-width letter head is present at the top of the page.
		 * ┌───┐
		 * │ L │
		 * ├───┤
		 * │ C │
		 *
		 */

	@layer pf.core {
		main {
			inline-size: 100%;
		}
	}
</style>
