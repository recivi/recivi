---
import "virtual:pf/custom-css/Print";
import "../../styles/print.css";

import { Letterhead } from "virtual:pf/components";
import config from "virtual:pf/config";
import Root from "virtual:pf/layouts/Root";

import { getFullPageTitle } from "../../utils/metas";
import type { PrintProps } from "../props/Print";

type Props = PrintProps;
const { title = "Print", ...attrs } = Astro.props;

const creditsCss = config.showCredits
	? `@layer pf-media {
	@page {
		@bottom-center {
			content: "Built with Récivi:";
			color: var(--pf-color-fg-subtle);
			text-align: right;
			padding-inline-end: calc(2 * var(--pf-spacing));
		}

		@bottom-right {
			content: "recivi.pages.dev";
			color: var(--pf-color-fg-subtle);
			font-family: var(--pf-font-family-monospace);
			font-size: var(--pf-font-size-monospace);
			width: fit-content;
		}
	}
}`
	: "";
---

<Root data-media="print" {...attrs}>
	<Fragment slot="head">
		<title>{getFullPageTitle(title)}</title>

		{creditsCss ? <style is:inline set:html={creditsCss} /> : undefined}

		<slot name="head" />
	</Fragment>

	<!-- DEFAULT SLOT -->
	<main data-pf-print-content>
		<div class="header">
			<Letterhead />
		</div>

		<div class="content">
			<slot />
		</div>
	</main>
</Root>

<script>
	import {
		paginatePrintPreview,
		waitForInitialLayout,
	} from "../../utils/print_preview";

	try {
		// Resolves on `load`, so every listener subscribed while the consumers'
		// module scripts evaluated is in place before the dispatch below. A
		// consumer that subscribes after its own `await` misses the event.
		await waitForInitialLayout();
		const detail = paginatePrintPreview();
		const event = new CustomEvent("pf:paginated-print-preview", { detail });
		// Unlike "native" events, which the browser fires by queuing a task on
		// the event loop, `dispatchEvent` invokes all applicable event handlers
		// synchronously before returning. So we can immediately set the settled
		// flag on `window`.
		document.dispatchEvent(event);
	} catch (error) {
		// The capture proceeds either way, so leave a trace of why the preview
		// it captures is unpaginated. Settled must not imply succeeded.
		console.error("Could not paginate the print preview.", error);
	} finally {
		// The PDF capture job polls this flag so we must set it on every path to
		// avoid wasting the full timeout time.
		window.pfPrintPreviewSettled = true;
	}
</script>

<style>
	/*
		 * A full-width letter head is present at the top of the page.
		 * ┌───┐
		 * │ L │
		 * ├───┤
		 * │ C │
		 *
		 */

	@layer pf-core {
		main {
			inline-size: 100%;
		}
	}
</style>
