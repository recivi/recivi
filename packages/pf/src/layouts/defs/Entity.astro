---
import "virtual:pf/custom-css/Entity";

import { Breadcrumbs } from "virtual:pf/components";
import nav from "virtual:pf/nav";
import projectContext from "virtual:pf/project-context";

import { pageSchema } from "../../content";
import { getPageByEntrypoint } from "../../utils/collections";
import { getUrlFromPattern } from "../../utils/project_context";
import type { EntityProps } from "../props/Entity";
import Web from "./Web.astro";

type Props = EntityProps;
const {
	entityType: [singular, plural],
	name,
	description,
} = Astro.props;

const frontmatter = pageSchema.parse({
	title: `${singular}: ${name}`,
	description,
	// Banning the robots also means there is no need to add meta-tags.
	banRobots: true,
});

const indexUrl = nav.resume.index
	? getUrlFromPattern(projectContext, nav.resume.index.pattern)
	: undefined;
const indexPage = nav.resume.index
	? await getPageByEntrypoint(nav.resume.index.entrypoint)
	: undefined;
const title = indexPage?.data.title ?? "Résumé";
---

<Web {frontmatter} main={{ entity: singular.toLocaleLowerCase() }}>
	<Breadcrumbs
		slot="primary-header"
		crumbs={[
			{ url: { dest: "/", label: "Home" } },
			indexUrl ? { url: { dest: indexUrl, label: title } } : title,
			plural,
			name,
		]}
	/>

	<slot />
</Web>
