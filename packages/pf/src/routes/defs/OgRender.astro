---
import { Entity, PfDate } from "virtual:pf/components";
import config from "virtual:pf/config";
import reciviData from "virtual:recivi/data";

import { experimental_AstroContainer } from "astro/container";
import { getCollection } from "astro:content";

import Og from "../../layouts/defs/Og.astro";
import { isNotDraft } from "../../utils/collections";
import { getBlogPostUrl } from "../../utils/dynamic_pages";
import { entityToOg } from "../helpers/OgRender";
import type { OgRenderProps } from "../props/OgRender";

export async function getStaticPaths() {
	const container = await experimental_AstroContainer.create();
	const pages = await getCollection("pages", isNotDraft);
	const posts = await getCollection("blog", isNotDraft);
	const { education, work, creations } = reciviData;

	return [
		...pages.map((page) => ({
			params: { path: page.id },
			props: {
				title: page.data.ogTitle,
				description: page.data.description,
			} satisfies OgRenderProps,
		})),
		...posts.map((post) => {
			const path = getBlogPostUrl(post.id.slice(5));
			return path
				? {
						params: { path },
						props: {
							title: post.data.title,
							description: post.data.description,
							breadcrumbs: `Blog`,
							right: container.renderToString(PfDate, {
								props: { date: post.data.pubDate },
							}),
						} satisfies OgRenderProps,
					}
				: undefined;
		}),
		...education.map((institute) => entityToOg(institute, "Education")),
		...work.map((org) => entityToOg(org, "Organization")),
		...creations.map((epic) => entityToOg(epic, "Epic")),
	].filter((item) => item !== undefined);
}

const { title, description, breadcrumbs, right } = Astro.props;
---

<Og>
	<div>
		<div class="header">
			<span class="home">{config.title ?? reciviData.bio.name}</span>
			{
				breadcrumbs ? (
					<span class="breadcrumbs">/{breadcrumbs}</span>
				) : undefined
			}
			<span class="right" set:html={right} />
		</div>

		<main>
			<div class="title">
				{typeof title === "string" ? title : <Entity {...title} />}
			</div>

			<div class="description" set:html={description} />
		</main>
	</div>
</Og>

<style>
	@layer pf-components {
		.header,
		main {
			padding: calc(4 * var(--pf-spacing)) calc(8 * var(--pf-spacing));
		}

		.header {
			display: flex;
			align-items: center;
			border-block-end: 1px solid var(--pf-color-border);
			color: var(--pf-color-fg-subtle);
			font-size: var(--pf-font-size-l5);
		}

		.home {
			font-weight: 700;
		}

		.right {
			margin-inline-start: auto;
		}

		.title {
			margin-block-end: calc(4 * var(--pf-spacing));
			color: var(--pf-color-accent);
			font-weight: 600;
			font-size: var(--pf-font-size-l1);
		}

		.description {
			font-size: var(--pf-font-size-l5);
		}
	}
</style>
