---
// Renders a skill and its sub-skills.

import { Brand } from "virtual:pf/components";

import type { Skill } from "@recivi/schema";

import type { SkillProps } from "../props/Skill";

type Props = SkillProps;
const { skill, class: className, ...attrs } = Astro.props;
---

<span class:list={["pf-skill", className]} {...attrs}>
	{
		typeof skill === "string" ? (
			skill
		) : (
			<Fragment>
				{skill.id ? (
					<Brand
						icon={{ name: skill.id, title: skill.name }}
						name={skill.name}
					/>
				) : (
					skill.name
				)}
				{skill.subSkills.length ? (
					<ul class="sub-skills">
						{skill.subSkills?.map((subSkill: Skill) => (
							<li>
								<Astro.self skill={subSkill} />
							</li>
						))}
					</ul>
				) : undefined}
			</Fragment>
		)
	}
</span>

<style>
	@layer pf.components {
		.pf-skill {
			.sub-skills {
				display: inline-flex;
				margin-block: 0;
				padding-inline-start: 0;
				color: var(--pf-color-fg-subtle);

				li {
					display: flex;

					&::before {
						content: "·";
						margin-inline: calc(2 * var(--pf-spacing));
					}
				}
			}
		}
	}
</style>
