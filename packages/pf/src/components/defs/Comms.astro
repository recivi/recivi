---
// Render all communication channels as a list.

import { Anchor, Brand } from "virtual:pf/components";
import reciviData from "virtual:recivi/data";

import {
	webToComm,
	emailToComm,
	phoneToComm,
	profileToComm,
} from "../../utils/comms";
import type { CommsProps } from "../props/Comms";

type Props = CommsProps;
const { filterTag, class: className, ...attrs } = Astro.props;

const { contact: { emails = [], phones = [] } = {}, profiles = [] } =
	reciviData.bio;

const siteComm = webToComm();
const emailComms = emails.map((email) => emailToComm(email));
const phoneComms = phones.map((phone) => phoneToComm(phone));
const profileComms = profiles
	.filter((profile) => !filterTag || profile.tags.includes(filterTag))
	.map((profile) => profileToComm(profile));
---

<div class:list={["pf-comms", "print-only", className]} {...attrs}>
	<div class="row">
		{
			siteComm ? (
				<span class="comm">
					<strong>Website:&nbsp;</strong>
					<Anchor {...siteComm.anchor} />
				</span>
			) : undefined
		}
		{
			[emailComms, phoneComms].map((commSet) => (
				<span class="comm">
					<strong>{commSet[0]?.title}:&nbsp;</strong>
					{commSet.map((comm, idx, allComms) => (
						<Fragment>
							<Anchor {...comm.anchor} />
							{idx < allComms.length - 1 ? ", " : undefined}
						</Fragment>
					))}
				</span>
			))
		}
	</div>
	<div class="row">
		{
			profileComms.map((comm) => (
				<span class="comm">
					<strong>{comm.title}:&nbsp;</strong>
					<Anchor {...comm.anchor} />
				</span>
			))
		}
	</div>
</div>
<ul class:list={["pf-comms", "web-only", className]} {...attrs}>
	{
		[...emailComms, ...phoneComms, ...profileComms].map((comm) => (
			<li>
				<Brand {...comm} />
			</li>
		))
	}
</ul>

<style>
	@layer pf.components {
		:root:not([data-media="print"]) {
			.pf-comms {
				columns: 2;
				padding-inline-start: 0;
				list-style: none;

				.pf-icon {
					color: var(--pf-color-accent);
				}
			}
		}

		:root[data-media="print"] {
			.pf-comms {
				.row {
					.comm:not(:first-of-type)::before {
						content: "·";
						color: var(--pf-color-fg-subtle);
						margin-inline: calc(2 * var(--pf-spacing));
					}
				}
			}
		}
	}
</style>
