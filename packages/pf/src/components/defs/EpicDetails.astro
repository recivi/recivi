---
// Render a detailed page for an epic and its projects.

import { Anchor, Entity, ProjectDetails } from "virtual:pf/components";

import { getLinkedOrg } from "../../recivi/relations";
import type { EpicDetailsProps } from "../props/EpicDetails";

type Props = EpicDetailsProps;
const {
	epic,
	filterTag,
	headingOffset = 0,
	class: className,
	...attrs
} = Astro.props;

const linkedOrg = getLinkedOrg(epic);

const Heading = `h${1 + headingOffset}`;
---

<div class:list={["pf-epic-details", className]} {...attrs}>
	<div class="epic-header">
		<Heading>
			<Entity entity={epic} />
			{
				linkedOrg ? (
					<span class="meta print-only">
						&nbsp;(by <Entity entity={linkedOrg} />)
					</span>
				) : undefined
			}
		</Heading>
		{epic.url ? <Anchor class="meta print-only" url={epic.url} /> : undefined}
	</div>

	<dl class="web-only">
		{
			epic.url ? (
				<Fragment>
					<dt>URL</dt>
					<dd>
						<Anchor url={epic.url} />
					</dd>
				</Fragment>
			) : undefined
		}
		{
			linkedOrg ? (
				<Fragment>
					<dt>Org</dt>
					<dd>
						<Entity entity={linkedOrg} useInternalLink />
					</dd>
				</Fragment>
			) : undefined
		}
	</dl>

	<div class="content">
		{
			epic.description ? (
				<p class="web-only" set:html={epic.description} />
			) : undefined
		}

		{
			epic.summary ? (
				<p class="print-only" set:html={epic.summary} />
			) : undefined
		}

		{
			epic.projects
				.filter((project) => !filterTag || project.tags.includes(filterTag))
				.map((project) => (
					<ProjectDetails {project} headingOffset={headingOffset + 1} />
				))
		}
	</div>
</div>

<style>
	@layer pf.components {
		.pf-epic-details {
			/* Don't break page inside an org details block. */
			break-inside: avoid-page;
			margin-block-end: calc(2 * var(--pf-spacing));

			.epic-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: calc(2 * var(--pf-spacing));

				.meta {
					color: var(--pf-color-fg-subtle);
				}
			}
		}
	}
</style>
