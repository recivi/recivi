---
import { Table } from "virtual:pf/components";
import config from "virtual:pf/config";

import { getCollection } from "astro:content";

import {
	getCategories,
	getPostsTable,
	isNotDraft,
} from "../../utils/collections";

const { class: className, ...attrs } = Astro.props;

const { showCategories } = config.pages.blog;

const posts = (await getCollection("blog", isNotDraft)).toSorted(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const postsTable = getPostsTable(posts);

const categories = await getCategories();
---

<div
	class:list={["pf-posts-table", className]}
	{...attrs}
	x-data="{ activeCategories: [] }"
>
	{
		showCategories ? (
			<div class="js-enabled-only">
				<p>
					Click on a category to highlight the posts that belong to that
					category.
				</p>
				{categories.length ? (
					<fieldset class="categories-fieldset">
						<legend class="sr-only">Categories</legend>
						{categories.map((category) => (
							<label class="category-field">
								<input
									type="checkbox"
									value={category}
									x-model="activeCategories"
								/>
								{category}
							</label>
						))}
					</fieldset>
				) : (
					<p>∅ There are no categories.</p>
				)}
			</div>
		) : undefined
	}
	{
		posts.length ? (
			<Table table={postsTable} />
		) : (
			<p>∅ There are no blog posts.</p>
		)
	}
</div>

<style>
	@layer pf-components {
		.categories-fieldset {
			display: flex;
			flex-wrap: wrap;
			gap: var(--pf-spacing);

			.category-field {
				border: 1px solid var(--pf-color-border);
				border-radius: var(--pf-spacing);
				padding: calc(0.5 * var(--pf-spacing)) var(--pf-spacing);
				cursor: pointer;

				&:has(input:checked) {
					border-color: var(--pf-color-accent);
				}

				input {
					display: none;
				}
			}
		}
	}
</style>
