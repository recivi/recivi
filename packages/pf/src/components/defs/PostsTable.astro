---
import { Table } from "virtual:pf/components";

import { getCollection } from "astro:content";

import type { BaseProps } from "../../types/props";
import { getPostsTable, isNotDraft } from "../../utils/collections";

type Props = BaseProps;
const { class: className, ...attrs } = Astro.props;

const posts = (await getCollection("blog", isNotDraft)).toSorted(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const postsTable = getPostsTable(posts, { groupBy: "month" });
---

<Table class:list={["pf-posts-table", className]} table={postsTable} {...attrs}>
	<slot />
</Table>
