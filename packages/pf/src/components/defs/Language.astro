---
import type { LanguageProps } from "../props/Language";
import { LANGUAGE_PROFICIENCIES } from "@recivi/schema";
import { formatLanguageName, formatProficiency } from "@recivi/schema/display";

type Props = LanguageProps;
const { language, class: className, ...attrs } = Astro.props;

const MODES = ["listen", "speak", "read", "write"] as const;
---

<span class:list={["pf-language", className]} {...attrs}>
	{formatLanguageName(language.name)}
	<div>
		<ul class="linear">
			{
				LANGUAGE_PROFICIENCIES.filter((level) => level !== "no").map(
					(level) => {
						const modes = MODES.filter((mode) => language[mode] === level);
						return modes.length ? (
							<li>
								{modes.map((mode) => mode[0]?.toUpperCase()).join("")}
								:&nbsp;
								{formatProficiency(level)}
							</li>
						) : undefined;
					},
				)
			}
		</ul>
	</div>
</span>
