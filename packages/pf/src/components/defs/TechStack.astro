---
// Render a list of technologies as icons.
// This component is also a table renderer.

import { Brand } from "virtual:pf/components";

import type { TechStackProps } from "../props/TechStack";

type Props = TechStackProps;
const {
	technologies,
	showNames = false,
	class: className,
	...attrs
} = Astro.props;
---

<ul class:list={["pf-tech-stack", "linear", className]} {...attrs}>
	{
		technologies
			// Either the technology will show an icon or a name.
			.filter((technology) => technology.id || showNames)
			.map((technology) => (
				<li>
					<Brand
						icon={
							technology.id
								? {
										name: technology.id,
										title: technology.name,
										class: "web-only",
									}
								: undefined
						}
						name={showNames ? technology.name : ""}
					/>
				</li>
			))
	}
</ul>
