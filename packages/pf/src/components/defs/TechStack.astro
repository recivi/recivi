---
// Render a list of technologies as icons.
// This component is also a table renderer.

import { Icon } from "virtual:pf/components";

import type { TechStackProps } from "../props/TechStack";

type Props = TechStackProps;
const {
	technologies,
	showNames = false,
	class: className,
	...attrs
} = Astro.props;
---

<ul class:list={["pf-tech-stack", className]} {...attrs}>
	{
		technologies
			// Either the technology will show an icon or a name.
			.filter((technology) => technology.id || showNames)
			.map((technology) => (
				<li>
					{technology.id ? (
						<Icon
							class="web-only"
							name={technology.id}
							title={technology.name}
						/>
					) : undefined}
					{showNames ? technology.name : undefined}
				</li>
			))
	}
</ul>

<style>
	@layer pf.components {
		.pf-tech-stack {
			display: inline-flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			margin-block: 0;
			padding-inline-start: 0;

			li {
				display: flex;
				align-items: center;
				gap: 0.5rem;

				&:not(:last-child)::after {
					content: "·";
					color: var(--pf-color-fg-subtle);
				}
			}
		}
	}
</style>
