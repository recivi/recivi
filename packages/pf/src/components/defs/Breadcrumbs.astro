---
// Render a breadcrumb navigation trail.

import { Anchor } from "virtual:pf/components";

import type { BreadcrumbsProps } from "../props/Breadcrumbs";

type Props = BreadcrumbsProps;
const { crumbs, class: className, ...attrs } = Astro.props as Props;
---

<ul class:list={["pf-breadcrumbs", className, "linear"]} {...attrs}>
	{
		crumbs.map((crumb) => (
			<li>
				{typeof crumb === "string" ? (
					<span>{crumb}</span>
				) : (
					<Anchor {...crumb} />
				)}
			</li>
		))
	}
</ul>

<style>
	@layer pf-components {
		.pf-breadcrumbs {
			--list-linear-separator: "/";

			&::after {
				content: var(--list-linear-separator);
				color: var(--pf-color-fg-subtle);
				margin-inline: calc(2 * var(--pf-spacing));
			}
		}
	}
</style>
