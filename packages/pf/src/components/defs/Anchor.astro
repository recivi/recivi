---
// Render an anchor link.
// This component is also a table renderer.

import { urlReadableDest } from "@recivi/schema/display";
import { urlDest, urlLabel } from "@recivi/schema/utils";

import type { AnchorProps } from "../props/Anchor";

type Props = AnchorProps;
const { url, class: className, ...attrs } = Astro.props;

const dest = urlDest(url);

const currentPath = Astro.url.pathname;
const isExactActive = currentPath === dest;
const isActive = currentPath.startsWith(dest);
---

<a
	class:list={[
		"pf-anchor",
		className,
		{ active: isActive, exact: isExactActive },
	]}
	href={dest}
	{...attrs}
>
	<slot>
		<span class="web-only">{urlLabel(url)}</span>
		<span class="dest print-only">{urlReadableDest(url)}</span>
	</slot>
</a>

<style>
	@layer pf-components {
		.pf-anchor {
			&.exact {
				color: var(--pf-color-accent);
			}

			.dest {
				font-family: var(--pf-font-family-monospace);
				font-size: 0.9em;
			}
		}
	}
</style>
