---
// Render a brand logo, name and link.

import { Anchor, Icon } from "virtual:pf/components";

import type { BrandProps } from "../props/Brand";

type Props = BrandProps;
const { icon, anchor, name, class: className, ...attrs } = Astro.props;
---

<span class:list={["pf-brand", className]} {...attrs}>
	{
		anchor ? (
			<Anchor {...anchor}>
				{icon ? <Icon {...icon} class={["icon", icon.class]} /> : undefined}
				{name}
			</Anchor>
		) : (
			<Fragment>
				{icon ? <Icon {...icon} class={["icon", icon.class]} /> : undefined}
				{name}
			</Fragment>
		)
	}
</span>

<style>
	@layer pf.components {
		.pf-brand {
			display: inline-block;

			.icon {
				margin-inline-end: var(--pf-spacing);
			}
		}
	}
</style>
