---
// Render the footer with debug information and, optionally, credits.

import { Brand } from "virtual:pf/components";
import config from "virtual:pf/config";

import type { BaseProps } from "../../types/props";

type Props = BaseProps;
const { class: className, ...attrs } = Astro.props;
---

<footer class:list={["pf-footer", className]} {...attrs}>
	<div>Thanks for visiting!</div>
	{
		config.showCredits ? (
			<div>
				Built with&nbsp;
				<Brand
					anchor={{ url: "https://recivi.dhruvkb.dev" }}
					icon={{ pack: "pf", name: "recivi", title: "Récivi" }}
					name="Récivi"
				/>
			</div>
		) : undefined
	}
</footer>

<style>
	@layer pf.components {
		.pf-footer {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: calc(2 * var(--pf-spacing)) calc(4 * var(--pf-spacing));
			border-block-start: 1px solid var(--pf-color-border);
			padding: calc(4 * var(--pf-spacing));
			color: var(--pf-color-fg-subtle);
		}
	}
</style>
