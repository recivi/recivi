---
// Render the list of languages from Récivi data.

import { Language } from "virtual:pf/components";
import reciviData from "virtual:recivi/data";

import { formatLanguages } from "@recivi/schema/display";
import {
	getOverallProficiency,
	getProficiencyScore,
} from "@recivi/schema/utils";

import type { LanguageListProps } from "../props/LanguageList";

type Props = LanguageListProps;
const {
	cutoffProficiency = "no",
	includesAmbiguous = true,
	class: className,
	...attrs
} = Astro.props;

const languages = reciviData.languages.filter((language) => {
	if (!cutoffProficiency) return true;

	const overall = getOverallProficiency(language);
	if (!overall) return includesAmbiguous;

	const overallScore = getProficiencyScore(overall);
	const cutoffScore = getProficiencyScore(cutoffProficiency);
	return overallScore >= cutoffScore;
});
---

<ul class:list={["pf-language-list", "web-only", className]} {...attrs}>
	{
		languages.map((language) => (
			<li>
				<Language {language} />
			</li>
		))
	}
</ul>
<div class:list={["pf-language-list", "print-only", className]} {...attrs}>
	{formatLanguages(languages)}
</div>
