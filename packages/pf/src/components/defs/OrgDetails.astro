---
// Render a detailed page for an org and its roles.

import { Anchor, Entity, RoleDetails } from "virtual:pf/components";

import { formatAddress } from "@recivi/schema/display";

import type { OrgDetailsProps } from "../props/OrgDetails";

type Props = OrgDetailsProps;
const {
	org,
	filterTag,
	headingOffset = 0,
	class: className,
	...attrs
} = Astro.props;

const Heading = `h${1 + headingOffset}`;
---

<div class:list={["pf-org-details", className]} {...attrs}>
	<div class="org-header">
		<Heading>
			<Entity entity={org} />
		</Heading>
		{org.url ? <Anchor class="meta print-only" url={org.url} /> : undefined}
	</div>

	<dl class="web-only">
		{
			org.url ? (
				<Fragment>
					<dt>URL</dt>
					<dd>
						<Anchor url={org.url} />
					</dd>
				</Fragment>
			) : undefined
		}
		{
			org.address ? (
				<Fragment>
					<dt>Address</dt>
					<dd>{formatAddress(org.address)}</dd>
				</Fragment>
			) : undefined
		}
	</dl>

	<div class="content">
		{
			org.description ? (
				<p class="web-only" set:html={org.description} />
			) : undefined
		}

		{org.summary ? <p class="print-only" set:html={org.summary} /> : undefined}

		{
			org.roles
				.filter((role) => !filterTag || role.tags.includes(filterTag))
				.map((role) => <RoleDetails {role} headingOffset={headingOffset + 1} />)
		}
	</div>
</div>

<style>
	@layer pf.components {
		.pf-org-details {
			/* Don't break page inside an org details block. */
			break-inside: avoid-page;
			margin-block-end: calc(2 * var(--pf-spacing));

			.org-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: calc(2 * var(--pf-spacing));

				.meta {
					color: var(--pf-color-fg-subtle);
				}
			}
		}
	}
</style>
