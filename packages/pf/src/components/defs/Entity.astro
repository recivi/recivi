---
// Render an institute, org or epic as a brand.
// This component is also a table renderer.

import { Brand } from "virtual:pf/components";

import { isInstitute } from "@recivi/schema/utils";

import { getResumeEntityUrl } from "../../utils/dynamic_pages";
import type { BrandProps } from "../props/Brand";
import type { EntityProps } from "../props/Entity";

type Props = EntityProps;
const {
	entity,
	useInternalLink = false,
	useShortName = false,
	stripInstituteIcon = true,
	class: className,
	...attrs
} = Astro.props;

// Most institutes either
// - don't have a logo at all
// - have a complex logo that doesn't scale down well to icon size
// - don't provide SVG assets of the logo
// - don't have their logo present in any ready-made icon pack
//
// So the default choice for institutes is to strip the icon unless the user
// explicitly passes the prop to keep it.
const icon =
	entity.id && !(isInstitute(entity) && stripInstituteIcon)
		? { name: entity.id, title: entity.name }
		: undefined;

const internalDest = getResumeEntityUrl(entity);

const anchor = useInternalLink
	? internalDest
		? { url: { dest: internalDest, label: "" } }
		: undefined
	: entity.url
		? { url: entity.url }
		: undefined;

const brand: BrandProps = {
	icon,
	anchor,
	name:
		useShortName && "shortName" in entity && entity.shortName
			? entity.shortName
			: entity.name,
};
---

<Brand {...brand} {...attrs} class={["pf-entity", className, brand.class]} />
