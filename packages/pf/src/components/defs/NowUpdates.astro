---
import { NowUpdate } from "virtual:pf/components";

import { getCollection } from "astro:content";

import { isNotDraft } from "../../utils/collections";
import type { NowUpdatesProps } from "../props/NowUpdates";

const updates = (await getCollection("now", isNotDraft)).toSorted(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

type Props = NowUpdatesProps;
const { limit, class: className, ...attrs } = Astro.props;
---

<ul class:list={["pf-now-updates", className]} {...attrs}>
	{
		updates.slice(0, limit).map((update, index) => (
			<li class="update">
				<NowUpdate isLatest={index === 0} {update} />
			</li>
		))
	}
</ul>

<style>
	@layer pf-components {
		.pf-now-updates {
			list-style: none;
			padding: 0;

			.update {
				&:not(:last-child) {
					padding-block-end: calc(4 * var(--pf-spacing));

					&::after {
						content: "";
						display: block;
						border-bottom: 1px dashed var(--pf-color-border);
						margin-inline: calc(-4 * var(--pf-spacing));
						margin-block-start: calc(4 * var(--pf-spacing));
					}
				}
			}
		}
	}
</style>
