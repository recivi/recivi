---
// Render a blog post listing entry.
// This component is also a table renderer.

import nav from "virtual:pf/nav";
import { Anchor, Icon } from "virtual:pf/components";

import type { PostProps } from "../props/Post";

type Props = PostProps;
const {
	post: { id, data },
	class: className,
	...attrs
} = Astro.props;

const dest = nav.blogPost?.replace("[postSlug]", id.slice(5));
---

<div class:list={["pf-post", className]} {...attrs}>
	{
		dest ? (
			<Anchor url={{ dest, label: data.title }}>{data.title}</Anchor>
		) : (
			<span>{data.title}</span>
		)
	}
	{
		data.isDraft ? (
			<Icon
				class="draft"
				name="pencil"
				pack="lucide"
				title="Draft, hidden in prod"
			/>
		) : undefined
	}
	<ul>
		{
			data.categories.map((category) => (
				<li
					x-data={JSON.stringify({ category })}
					x-bind:class="activeCategories.includes(category) && 'active'"
				>
					{category}
				</li>
			))
		}
	</ul>
</div>

<style>
	@layer pf.components {
		.pf-post {
			.draft {
				color: var(--pf-color-yellow);
			}

			ul {
				display: flex;
				gap: 0.5rem;
				margin-block: 0;
				padding-inline-start: 0;
				list-style: none;

				li {
					display: flex;
					align-items: center;
					gap: 0.5rem;
					color: var(--pf-color-fg-subtle);

					&.active {
						color: var(--pf-color-accent);
					}

					&:not(:last-child)::after {
						content: "·";
					}
				}
			}
		}
	}
</style>
