---
// Render a blog post listing entry.
// This component is also a table renderer.

import { Anchor, Icon } from "virtual:pf/components";

import { getBlogPostUrl } from "../../utils/dynamic_pages";
import type { PostProps } from "../props/Post";

type Props = PostProps;
const {
	post: { id, data },
	class: className,
	...attrs
} = Astro.props;

const dest = getBlogPostUrl(id.slice(5));
---

<div class:list={["pf-post", className]} {...attrs}>
	{
		dest ? (
			<Anchor class="post-title" url={{ dest, label: data.title }}>
				{data.title}
			</Anchor>
		) : (
			<span class="post-title">
				{data.title}
				<Icon
					class="missing-component"
					name="square-dashed"
					pack="lucide"
					title="Missing `[postSlug].astro`"
				/>
			</span>
		)
	}
	{
		data.isDraft ? (
			<Icon
				class="draft"
				name="pencil"
				pack="lucide"
				title="Draft, hidden in prod"
			/>
		) : undefined
	}
	<div>
		<ul class="categories-list linear">
			{
				data.categories.map((category) => (
					<li class="category">
						<span
							x-data={JSON.stringify({ category })}
							x-bind:data-is-selected-category="activeCategories.includes(category)"
						>
							{category}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	@layer pf-components {
		.pf-post {
			.draft {
				color: var(--pf-color-yellow);
				margin-inline-start: var(--pf-spacing);
			}

			.missing-component {
				color: var(--pf-color-red);
				margin-inline-start: var(--pf-spacing);
			}

			.categories-list {
				color: var(--pf-color-fg-subtle);

				.category {
					span {
						&[data-is-selected-category] {
							color: var(--pf-color-fg);
						}
					}
				}
			}

			:global([data-matches-some-selected-category]) & {
				.post-title {
					color: var(--pf-color-accent);
				}
			}

			:global([data-matches-no-selected-category]) & {
				.post-title {
					color: var(--pf-color-fg-subtle);
				}
			}
		}
	}
</style>
