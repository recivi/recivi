---
// Render a card displaying epic and projects information.

import { Anchor, Entity, TechStack } from "virtual:pf/components";

import type { EpicCardProps } from "../props/EpicCard";

type Props = EpicCardProps;
const { epic, class: className, ...attrs } = Astro.props;
---

<div class:list={["pf-epic-card", className]} {...attrs}>
	<Entity entity={epic} useInternalLink />
	<ul class="projects-list">
		{
			epic.projects.map((project) => (
				<li class="project">
					{project.url ? (
						<Anchor url={project.url}>{project.name}</Anchor>
					) : (
						project.name
					)}
					<TechStack class="tech-stack" technologies={project.technologies} />
				</li>
			))
		}
	</ul>
</div>

<style>
	@layer pf.components {
		.pf-epic-card {
			display: flex;
			flex-direction: column;
			gap: var(--pf-spacing);
			margin-inline: calc(-4 * var(--pf-spacing));
			border-block-end: 1px dashed var(--pf-color-border);
			padding-inline: calc(4 * var(--pf-spacing));
			padding-block: var(--pf-spacing);

			& > * {
				margin: 0;
			}

			.projects-list {
				padding-inline-start: 0;
				list-style: none;

				.project {
					display: flex;
					justify-content: space-between;
					gap: calc(4 * var(--pf-spacing));

					.tech-stack {
						color: var(--pf-color-fg-subtle);
					}
				}
			}
		}
	}
</style>
