{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@recivi/pf",
	"version": "0.0.5",
	"description": "personal portfolio powered by Récivi, a new kind of résumé for computers and humans, in that order",
	"keywords": [
		"astro-integration",
		"cv",
		"portfolio",
		"renderer",
		"resume"
	],
	"homepage": "https://recivi.dhruvkb.dev/",
	"bugs": "https://github.com/recivi/recivi/issues",
	"license": "GPL-3.0-or-later",
	"author": {
		"name": "Dhruv Bhanushali",
		"url": "https://dhruvkb.dev/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/recivi/recivi.git",
		"directory": "packages/pf"
	},
	"funding": "https://github.com/sponsors/dhruvkb",
	"files": [
		"src"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./content": "./src/content.ts",
		"./components/defs/*": "./src/components/defs/*",
		"./components/props/*": "./src/components/props/*.ts",
		"./layouts/defs/*": "./src/layouts/defs/*",
		"./layouts/props/*": "./src/layouts/props/*.ts",
		"./routes/*": "./src/routes/*",
		"./recivi/*": "./src/recivi/*.ts",
		"./styles/*": "./src/styles/*",
		"./types/*": "./src/types/*.ts",
		"./utils/*": "./src/utils/*.ts"
	},
	"scripts": {
		"barrel": "tsx src/scripts/barrel.ts",
		"schema": "pnpm barrel && tsx src/scripts/schema.ts",
		"check": "pnpm barrel && astro check",
		"astro": "pnpm barrel && astro",
		"test": "tsx --test"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.3.4",
		"@astrojs/mdx": "^7.0.3",
		"@astrojs/rss": "^4.0.18",
		"@iconify-json/lucide": "^1.2.127",
		"@iconify-json/simple-icons": "^1.2.94",
		"@recivi/schema": "workspace:^",
		"puppeteer": "^25.7.0",
		"sharp": "catalog:"
	},
	"devDependencies": {
		"@astrojs/check": "catalog:",
		"@types/mdast": "^4.0.4",
		"astro": "catalog:",
		"satteri": "^0.9.5",
		"tsx": "^4.21.0",
		"vite": "^8.1.5"
	},
	"peerDependencies": {
		"astro": "catalog:"
	},
	"packageManager": "pnpm@11.15.1"
}
