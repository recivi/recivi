{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc"],
	"env": {
		"browser": true
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"pedantic": "error",
		"perf": "error"
	},
	"rules": {
		// Allow `TODO` comments as they are a crucial part of the dev process.
		"eslint/no-warning-comments": "off"
	}
}
